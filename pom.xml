<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example</groupId>
  <artifactId>auto_rental</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>auto_rental</name>
  <url>http://maven.apache.org</url>

  <!-- SpringBoot父工程，统一管理Spring全家桶依赖版本 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.1.12</version>
  </parent>

  <properties>
    <!-- 项目源码文件编码统一为UTF-8，解决中文乱码 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Maven编译源码标准：JDK21语法 -->
    <maven.compiler.source>21</maven.compiler.source>
    <!-- 编译输出class兼容运行环境：JDK21 -->
    <maven.compiler.target>21</maven.compiler.target>
    <!-- MyBatis-Plus核心框架版本 -->
    <mybatis-plus.version>3.5.11</mybatis-plus.version>
    <!-- MyBatis-Plus代码生成器版本，自动生成CRUD基础代码 -->
    <mybatis-plus-generator.version>3.5.11</mybatis-plus-generator.version>
    <!-- FastJson2 JSON序列化工具版本，修复老版本安全漏洞 -->
    <fastjson.version>2.0.47</fastjson.version>
    <!-- MySQL8.x JDBC驱动版本 -->
    <mysql.version>8.0.33</mysql.version>
    <!-- SpringDoc接口文档版本（SpringBoot3替代Swagger3） -->
    <springdoc.version>2.2.0</springdoc.version>
    <!-- Hutool国产全能工具类库版本 -->
    <hutool.version>5.8.26</hutool.version>
    <!-- JJWT JWT登录令牌工具版本 -->
    <jwt.version>0.12.5</jwt.version>
    <!-- 阿里云OSS文件存储SDK版本 -->
    <aliyun-oss.version>3.17.4</aliyun-oss.version>
    <activation.version>1.1.1</activation.version>
    <!-- EasyExcel大数据Excel读写工具版本，避免POI内存溢出 -->
    <easyexcel.version>3.3.3</easyexcel.version>
  </properties>

  <dependencies>
    <!-- Lombok：简化实体类get/set/toString，仅编译期生效 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

<!--    <dependency>-->
<!--      <groupId>org.mybatis</groupId>-->
<!--      <artifactId>mybatis-spring</artifactId>-->
<!--      <version>3.0.3</version>-->
<!--    </dependency>-->

    <!-- SpringBoot Web核心启动器：内置Tomcat、SpringMVC，提供HTTP接口能力 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- SpringBoot单元测试启动器：JUnit、MockMvc等测试工具，仅测试环境生效 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- SpringBoot热部署工具：修改代码自动重启服务，仅开发环境使用 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Redis缓存启动器：实现登录缓存、验证码、热点数据缓存 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- Freemarker模板引擎：后端渲染管理后台页面 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-freemarker</artifactId>
    </dependency>

    <!-- SpringSecurity安全框架：账号登录、接口权限控制、安全防护 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- SpringBoot邮件启动器：发送验证码、业务通知邮件 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- JJWT-JWT API：JWT令牌编译期抽象定义包 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jwt.version}</version>
    </dependency>
    <!-- JJWT-JWT 实现包：运行时生成、解析Token核心实现 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- JJWT-Jackson序列化包：JWT载荷JSON序列化依赖 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- MySQL8官方JDBC驱动：项目连接MySQL数据库必备 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
    </dependency>

    <!-- MyBatis-Plus整合SpringBoot启动器：简化数据库CRUD操作 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-boot-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <!-- MyBatis-Plus代码生成器：一键生成Entity、Mapper、Service、Controller模板代码 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-generator</artifactId>
      <version>${mybatis-plus-generator.version}</version>
    </dependency>

    <!-- FastJson2：高性能JSON序列化/反序列化工具 -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>fastjson</artifactId>
      <version>${fastjson.version}</version>
    </dependency>

    <!-- Hutool-all：国产全能工具库，封装日期、加密、文件、验证码等工具方法 -->
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
      <version>${hutool.version}</version>
    </dependency>

    <!-- 阿里云OSS SDK：实现图片、附件、文件上传下载至阿里云对象存储 -->
    <dependency>
      <groupId>com.aliyun.oss</groupId>
      <artifactId>aliyun-sdk-oss</artifactId>
      <version>${aliyun-oss.version}</version>
    </dependency>
    <!-- JAXB API：XML与Java对象转换API，SpringBoot3+JDK21需手动引入 -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.0</version>
    </dependency>
    <dependency>
      <groupId>javax.activation</groupId>
      <artifactId>activation</artifactId>
      <version>${activation.version}</version>
    </dependency>
    <!-- JAXB运行时实现：EasyExcel、XML解析底层依赖实现包 -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.2</version>
    </dependency>

    <!-- SpringDoc OpenAPI：SpringBoot3官方接口文档，可视化调试后端API -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- EasyExcel：阿里开源Excel读写框架，支持百万级大数据表格导入导出 -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>easyexcel</artifactId>
      <version>${easyexcel.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.mybatis</groupId>
          <artifactId>mybatis-spring</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Pinyin4j：汉字转拼音工具，用于搜索首字母、分类筛选等业务 -->
    <dependency>
      <groupId>com.belerweb</groupId>
      <artifactId>pinyin4j</artifactId>
      <version>2.5.1</version>
    </dependency>


  </dependencies>

  <!-- 补充SpringBoot打包插件（建议添加，用于打包可执行Jar包） -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>